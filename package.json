{
  "name": "auto-dosar-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "frontend",
    "backend",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace frontend run dev",
    "build": "npm --workspace frontend run build",
    "lint": "npm --workspace frontend run lint",
    "test:adi": "npm --workspace frontend exec tsx ../packages/adi-core/src/checklist/tests/checklistBuilder.demo.ts",
    "test:document-generation": "npm --workspace frontend exec tsx ../packages/adi-core/src/document-generation/tests/documentGenerationEngine.demo.ts",
    "test:twin": "npm --workspace frontend exec tsx ../packages/adi-core/src/twin/tests/digitalTwinEngine.test.ts",
    "test:knowledge": "npm --workspace frontend exec tsx ../packages/adi-core/src/knowledge/tests/knowledgeEngine.test.ts",
    "test:events": "npm --workspace frontend exec tsx ../packages/adi-core/src/events/tests/eventBus.test.ts",
    "test:rules": "npm --workspace frontend exec tsx ../packages/adi-core/src/rules/tests/ruleEngine.test.ts && npm run test:rule-dsl",
    "test:rule-dsl": "npm --workspace frontend exec tsx ../packages/adi-core/src/rules/tests/ruleDsl.test.ts",
    "test:operations": "npm --workspace frontend exec tsx ../packages/adi-core/src/operations/tests/operationRegistry.test.ts",
    "test:checklist": "npm --workspace frontend exec tsx ../packages/adi-core/src/checklist/tests/smartChecklistEngine.test.ts",
    "test:case-file": "npm --workspace frontend exec tsx ../packages/adi-core/src/case-file/tests/caseFileCore.test.ts"
  }
}
